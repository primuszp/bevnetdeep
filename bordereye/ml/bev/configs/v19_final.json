{
  "_comment": "BEV3 v19 footprint contract: v18 12-channel input, but segmentation predicts a complete rounded vehicle footprint from each OBB. Warm-start model weights from v18; reset optimizer because the objective changes.",
  "arch": "deep",
  "cbam_max": true,
  "sources": "synth,synthsparse,dales,wisar",
  "det_loss_weights": "synth=1,synthsparse=0.7,dales=1,wisar=1",
  "seg_loss_weights": "synth=1,synthsparse=0.7,dales=1,wisar=1",
  "source_weights": "synth=1.0,synthsparse=0.3,dales=4.5,wisar=0.65",
  "seg_target": "rounded_box",
  "seg_weight": 0.5,
  "seg_dice_weight": 0.25,
  "seg_tversky_weight": 0.5,
  "seg_tversky_alpha": 0.75,
  "seg_tversky_beta": 0.25,
  "pseudo_peak": 0.5,
  "pseudo_reg_weight": 0.25,
  "channel_scale_jitter": 0.08,
  "channel_noise_std": 0.01,
  "channel_dropout_prob": 0.02,
  "channel_dropout_overrides": "ground_shadow=0.2,shadow_edt=0.2,veh_width_hole=0.2",
  "cue_channels": "ground_shadow,shadow_edt,veh_width_hole,ground_edt,veh_h_p95,veh_sobel,veh_h_p95_hillshade_multi",
  "teacher_ramp_mode": "plateau",
  "consistency_weight": 0.03,
  "consistency_warmup_epochs": 30,
  "consistency_hm_thresh": 0.1,
  "seg_explain_weight": 0.08,
  "seg_explain_warmup_epochs": 30,
  "seg_explain_min_aniso": 0.05,
  "seg_explain_teacher": "target",
  "seg_center_weight": 0.05,
  "seg_center_warmup_epochs": 30,
  "seg_center_max_components": 32,
  "seg_center_min_area": 10.0,
  "seg_center_max_area": 1500.0,
  "seg_center_thresh": 0.4,
  "seg_center_radius": 3.0,
  "seg_center_peak": 0.75,
  "seg_center_min_aniso": 0.05,
  "seg_center_teacher": "target",
  "mask_anchor_reliability_power": 1.0,
  "orient_weight": 0.02,
  "orient_warmup_epochs": 30,
  "orient_min_aniso": 0.12,
  "moment_weight": 0.02,
  "moment_warmup_epochs": 30,
  "moment_loss_cap": 10.0,
  "z_height_weight": 0.0,
  "shadow_weight": 0.0,
  "gaussian_reg_weight": 0.25,
  "angle_loss_weight": 1.0,
  "z_reg_weight": 1.0,
  "height_reg_weight": 1.0,
  "epochs": 150,
  "min_epochs": 40,
  "crops_per_epoch": 1000,
  "val_crops": 640,
  "crop": 384,
  "batch": 4,
  "lr": 0.00015,
  "warmup_epochs": 15,
  "patience": 20,
  "workers": 4,
  "checkpoint_metric": "footprint_composite",
  "checkpoint_seg_lf_weight": 0.25,
  "checkpoint_center_weight": 0.10,
  "checkpoint_yaw_weight": 0.05,
  "checkpoint_bev_iou_weight": 0.15,
  "checkpoint_3d_iou_weight": 0.10,
  "checkpoint_observed_recall_weight": 0.10,
  "checkpoint_outside_weight": 0.15,
  "val_ema_alpha": 0.3,
  "cache_tiles": 3,
  "grad_clip": 1.0,
  "progress_every": 10,
  "device": "cuda",
  "no_pin_memory": true,
  "amp": true,
  "use_channels": "default",
  "full_coverage": true
}
